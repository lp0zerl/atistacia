-- dynamic_rule
CREATE TABLE IF NOT EXISTS dynamic_rule (
    id UUID PRIMARY KEY,
    product_name VARCHAR(255) NOT NULL,
    product_id UUID NOT NULL,
    product_text TEXT NOT NULL
);

-- rule_query
CREATE TABLE IF NOT EXISTS rule_query (
    id BIGSERIAL PRIMARY KEY,
    rule_id UUID NOT NULL REFERENCES dynamic_rule(id) ON DELETE CASCADE,
    query_type VARCHAR(50) NOT NULL,
    arguments JSONB NOT NULL,
    negate BOOLEAN NOT NULL
);

-- rule_stat
CREATE TABLE IF NOT EXISTS rule_stat (
    rule_id UUID PRIMARY KEY REFERENCES dynamic_rule(id) ON DELETE CASCADE,
    count BIGINT NOT NULL DEFAULT 0
);